{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "rootDir": "./src", // This tells TS exactly where your code starts
    "outDir": "./dist", // This is where the compiled JS will go
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"] // This tells TS to only look inside src
}
